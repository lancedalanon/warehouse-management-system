<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Reset Request</title>
    <style>
      body,
      html {
        margin: 0;
        padding: 0;
        font-family: system-ui, Arial, sans-serif;
        background-color: #ffffff; /* neutral light background */
        color: #1c1c1e; /* neutral light foreground */
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff; /* card background */
        border-radius: 10px; /* radius-lg */
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      }

      .header {
        background-color: #3366ff; /* primary color neutral light */
        color: #ffffff; /* primary foreground */
        padding: 20px;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
      }

      .content {
        padding: 30px 20px;
        line-height: 1.6;
        font-size: 16px;
        color: #1c1c1e; /* card foreground */
      }

      .button {
        display: inline-block;
        padding: 12px 25px;
        margin: 20px 0;
        background-color: #3366ff; /* primary */
        color: #ffffff !important; /* primary foreground */
        font-weight: bold;
        text-align: center;
        border-radius: 8px; /* radius-md */
        text-decoration: none;
      }

      .fallback-link {
        word-break: break-all;
        font-size: 14px;
        color: #3366ff; /* primary color */
      }

      .footer {
        padding: 20px;
        font-size: 12px;
        color: #555555; /* muted foreground */
        text-align: center;
      }

      @media (max-width: 600px) {
        .container {
          width: 95% !important;
        }
        .content {
          padding: 20px 15px;
        }
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>Reset Your Password</div>
      <div class='content'>
        <p>Hello {{firstName}},</p>
        <p>We received a request to reset your password for
          <strong>{{appName}}</strong>.</p>

        <p style='text-align: center;'>
          <a href='{{resetUrl}}' class='button'>Reset Password</a>
        </p>

        <p style='text-align: center; font-size: 14px; color: #555555;'>
          If the button above doesn’t work, copy and paste the following link
          into your browser:
        </p>
        <p class='fallback-link' style='text-align: center;'>
          <a
            href='{{resetUrl}}'
            style='color:#3366ff; text-decoration: underline;'
          >{{resetUrl}}</a>
        </p>

        <p>If you did not request a password reset, please ignore this email.</p>
      </div>

      <div class='footer'>
        &copy;
        {{year}}
        {{appName}}. All rights reserved.
      </div>
    </div>
  </body>
</html>