{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "jest",
    "dev": "ts-node-dev -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 \"src/**/*.{hbs,json,yaml}\" dist",
    "start": "node dist/index.js",
    "watch": "nodemon --watch ./src --exec 'ts-node -r tsconfig-paths/register src/index.ts'",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:migrate": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "db:rollback": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "db:status": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:show",
    "db:create": "npx typeorm migration:create",
    "db:generate": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:generate",
    "db:fresh": "npx typeorm-ts-node-commonjs -d src/data-source.ts schema:drop && npx typeorm-ts-node-commonjs -d src/data-source.ts migration:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^5.2.1",
    "fontkit": "^2.0.4",
    "handlebars": "^4.7.8",
    "html-pdf-node": "^1.0.7",
    "html-to-pdfmake": "^2.5.32",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "node-html-parser": "^7.0.2",
    "nodemailer": "^8.0.4",
    "pdfmake": "^0.2.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "roboto-font": "^0.1.0",
    "sqlite3": "^5.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.6",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-pdf-node": "^1.0.2",
    "@types/html-to-pdfmake": "^2.4.5",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.0.2",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.5",
    "@types/pdfmake": "^0.3.1",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "copyfiles": "^2.4.1",
    "esbuild-jest": "^0.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
