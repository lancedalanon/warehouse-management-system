# Use Node 22
FROM node:22-bullseye-slim

# Set working directory
WORKDIR /app

# Copy package files first for caching
COPY package*.json ./

# Install dependencies including dev
RUN npm install

# Copy local source code
COPY . .

# Copy .env for development if you have one
COPY .env .env

# Expose the React dev server port (usually 5173 or 3000)
EXPOSE 5173

# Start dev server with hot reload
CMD ["npm", "run", "dev"]